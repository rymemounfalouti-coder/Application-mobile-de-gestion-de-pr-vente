# Copy these values into your local environment before starting Flask.
# Never commit real production secrets.
DB_HOST=localhost
DB_NAME=prevente_db
DB_USER=postgres
DB_PASSWORD=replace-with-your-local-password
DB_PORT=5432

# Use a long, random value in every deployed environment.
JWT_SECRET_KEY=replace-with-a-long-random-secret
JWT_ACCESS_TOKEN_MINUTES=30

# Comma-separated origins allowed to call the API from a browser.
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080,http://127.0.0.1:8080

# memory:// is suitable for one local process; use Redis in production.
RATELIMIT_STORAGE_URI=memory://

FLASK_HOST=127.0.0.1
FLASK_PORT=5000
FLASK_DEBUG=0
